# ── Tools ──────────────────────────────────────────────────────────────────────
NEXTFLOW_BIN=/home/mahasiswa/miniconda3/envs/ngs_platform/bin/nextflow
FASTQC_PATH=/mnt/c/Users/Mahasiswa/Fastt/FastQC/fastqc
BIN_DIR=/home/mahasiswa/miniconda3/envs/ngs_platform/bin
SAMTOOLS_BIN=/usr/bin/samtools
BCFTOOLS_BIN=/usr/local/bin/bcftools

# ── Referensi Genom ────────────────────────────────────────────────────────────
REF_BASE=/mnt/c/Users/Mahasiswa/Fastt/ref_genome
# REF_BASE=/data/ref_genome   # path di AWS

# ── Direktori Data ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/mnt/c/Users/Mahasiswa/Fastt/ngs_backend_bcftools/data/uploads
RESULTS_DIR=/mnt/c/Users/Mahasiswa/Fastt/ngs_backend_bcftools/data/results
JOBS_DIR=/mnt/c/Users/Mahasiswa/Fastt/ngs_backend_bcftools/data/jobs

# ── Pipeline ───────────────────────────────────────────────────────────────────
NEXTFLOW_PROFILE=conda_env
DEFAULT_THREADS=4
MAX_CONCURRENT_JOBS=5

# ── Adapter Trimmomatic (opsional, default: folder adapters di conda env) ─────
# ADAPTER_FILE=/home/mahasiswa/miniconda3/envs/ngs_platform/share/trimmomatic/adapters/TruSeq3-PE-2.fa
# ADAPTER_FILE_SE=/home/mahasiswa/miniconda3/envs/ngs_platform/share/trimmomatic/adapters/TruSeq3-SE.fa
# ADAPTER_NEXTERA=/home/mahasiswa/miniconda3/envs/ngs_platform/share/trimmomatic/adapters/NexteraPE-PE.fa

# ── Java & versi Nextflow untuk subprocess pipeline ───────────────────────────
# NEXTFLOW_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# NEXTFLOW_VERSION=24.10.4

# ── Server ────────────────────────────────────────────────────────────────────
# Domain frontend yang boleh memanggil API, pisahkan dengan koma. "*" hanya untuk development.
# CORS_ORIGINS=https://app.example.com
# Mode yang dilaporkan ke frontend: disabled | mock | aws. "disabled" menolak submit (503).
# PIPELINE_MODE=aws
# LOG_LEVEL=INFO
