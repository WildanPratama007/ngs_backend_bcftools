/*
 * NGS E2E Platform — BCFTools Pipeline Configuration
 */

// Parameter default pipeline
params {
    reads          = null
    reads_r1       = null
    reads_r2       = null
    ref_genome     = "${projectDir}/ref_genome/chr22.fa"
    outdir         = "${projectDir}/results"
    fastqc_path    = "/mnt/c/Users/Mahasiswa/Fastt/FastQC/fastqc"
    ploidy         = "GRCh38"
    threads        = 4
    bin_dir        = "/home/mahasiswa/miniconda3/envs/ngs_platform/bin"
    samtools_bin   = "/usr/bin/samtools"
    bcftools_bin   = "/usr/bin/bcftools"
    target_bed     = null

    // ── Trimming parameters — bisa di-override dari API per job ──────────────
    // Default: clinical grade
    adapter_file                = "/home/mahasiswa/miniconda3/envs/ngs_platform/share/trimmomatic/adapters/TruSeq3-PE-2.fa"
    trim_sliding_window_quality = 20     // Q10-Q40 | preset: 20 (research), 30 (clinical)
    trim_min_len                = 36     // 20-100bp | recommended: 36 untuk PE 150bp
    trim_adapter                = true   // true = pakai ILLUMINACLIP | false = skip
    trim_poly_g                 = false  // true = tambah poly-G (NovaSeq/NextSeq only)

    // ── Alignment parameters ──────────────────────────────────────────────────
    mark_duplicates = true  // true = tandai PCR duplicate (default, direkomendasikan)
                            // false = skip (untuk PCR-free library atau amplicon sequencing)

    // BCFTools Filter thresholds — dipakai di GATHER_VCF
    // Sesuai UI: QUAL>=20 && FORMAT/DP>=10 && FORMAT/GQ>=20
    min_qual  = 20    // Minimum QUAL score
    min_dp    = 10    // Minimum read depth (DP) — naik dari 5 ke 10 (sesuai UI)
    min_gq    = 20    // Minimum Genotype Quality (GQ) — baru

    // BCFTools mpileup thresholds
    max_depth = 500   // Max depth per posisi (fix: 0 = bug, bukan unlimited)
                      // 500 untuk WGS standard, 2000 untuk WES panel dalam
    min_bq    = 20    // Minimum base quality untuk dihitung di pileup (clinical: 20)
    min_mq    = 20    // Minimum mapping quality read (clinical: 20)

    // Fix #19: jenis kelamin sampel untuk ploidy chrX dan chrY yang benar
    sample_sex = null
}    // Fix #19: jenis kelamin sampel untuk ploidy chrX dan chrY yang benar
    // Nilai: "male", "female", atau null (default: diploid untuk semua)
    sample_sex = null
}

// Resource allocation per proses
process {
    withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' {
        cpus   = 4
        memory = '16 GB'
    }
    withName: 'MARKDUPLICATES' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'CALL_VARIANTS' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'GATHER_VCF' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'COVERAGE_STATS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'GET_CHROMS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'FASTQC' {
        cpus   = 2
        memory = '4 GB'
    }
}

// Profil eksekusi
profiles {

    standard {
        process.executor = 'local'
        conda.enabled    = true

        process {
            withName: 'FASTQC'                    { conda = 'bioconda::fastqc' }
            withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' { conda = 'bioconda::trimmomatic' }
            withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' { conda = 'bioconda::bwa bioconda::samtools' }
            withName: 'CALL_VARIANTS|GATHER_VCF'  { conda = 'bioconda::bcftools' }
        }
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {
            // Fix #18: pakai path binary dari container (bukan path host /home/mahasiswa/...)
            // Fix #18: versi bcftools 1.13 (konsisten dengan README dan apt)
            withName: 'FASTQC' {
                container    = 'biocontainers/fastqc:v0.11.9_cv8'
            }
            withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' {
                container    = 'staphb/trimmomatic:0.39'
                beforeScript = 'export BIN_DIR=/usr/local/bin'
            }
            withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' {
                container    = 'biocontainers/bwa:v0.7.17_cv1'
                beforeScript = 'export BIN_DIR=/usr/local/bin SAMTOOLS_BIN=samtools'
            }
            withName: 'MARKDUPLICATES|COVERAGE_STATS|GET_CHROMS' {
                container    = 'biocontainers/samtools:v1.13-1-deb_cv1'
                beforeScript = 'export SAMTOOLS_BIN=samtools'
            }
            withName: 'CALL_VARIANTS|GATHER_VCF' {
                container    = 'biocontainers/bcftools:v1.13-1-deb_cv1'
                beforeScript = 'export BCFTOOLS_BIN=bcftools'
            }
        }
    }

    conda_env {
        process.executor     = 'local'
        conda.enabled        = true
        process.conda        = '/home/mahasiswa/miniconda3/envs/ngs_platform'
        process.beforeScript = 'export PATH=/home/mahasiswa/miniconda3/envs/ngs_platform/bin:$PATH'
    }
}

// Konfigurasi laporan eksekusi
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

// Fix #21: work dir default — di-override per job oleh API via -w flag
// agar job paralel tidak bentrok satu sama lain
workDir = "${params.outdir}/.work"
