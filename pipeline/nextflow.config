/*
 * NGS E2E Platform — BCFTools Pipeline Configuration
 */

// Parameter default pipeline
params {
    reads          = null
    reads_r1       = null
    reads_r2       = null
    ref_genome     = "${projectDir}/ref_genome/chr22.fa"
    outdir         = "${projectDir}/results"
    trimmer_opts   = "SLIDINGWINDOW:4:20 MINLEN:25 LEADING:3 TRAILING:3"
    fastqc_path    = "/mnt/c/Users/Mahasiswa/Fastt/FastQC/fastqc"
    ploidy         = "GRCh38"
    threads        = 4
    bin_dir        = "/home/mahasiswa/miniconda3/envs/ngs_platform/bin"
    samtools_bin   = "/usr/bin/samtools"
    bcftools_bin   = "/usr/bin/bcftools"
    target_bed     = null
    scatter_gather = "true"

    // BCFTools Filter thresholds
    min_qual = 20
    min_dp   = 5
}

// Resource allocation per proses
process {
    withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' {
        cpus   = 4
        memory = '16 GB'
    }
    withName: 'CALL_VARIANTS' {
        cpus   = 1
        memory = '4 GB'
    }
    withName: 'GATHER_VCF' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'COVERAGE_STATS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'GET_CHROMS' {
        cpus   = 1
        memory = '2 GB'
    }
    withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'FASTQC' {
        cpus   = 2
        memory = '4 GB'
    }
}

// Profil eksekusi
profiles {

    standard {
        process.executor = 'local'
        conda.enabled    = true

        process {
            withName: 'FASTQC'                    { conda = 'bioconda::fastqc' }
            withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' { conda = 'bioconda::trimmomatic' }
            withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' { conda = 'bioconda::bwa bioconda::samtools' }
            withName: 'CALL_VARIANTS|GATHER_VCF'  { conda = 'bioconda::bcftools' }
        }
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {
            withName: 'FASTQC'                    { container = 'biocontainers/fastqc:v0.11.9_cv8' }
            withName: 'TRIMMOMATIC_SE|TRIMMOMATIC_PE' { container = 'staphb/trimmomatic:0.39' }
            withName: 'BWA_ALIGN_SE|BWA_ALIGN_PE' { container = 'biocontainers/bwa:v0.7.17_cv1' }
            withName: 'CALL_VARIANTS|GATHER_VCF'  { container = 'biocontainers/bcftools:v1.9-1-deb_cv1' }
        }
    }

    conda_env {
        process.executor     = 'local'
        conda.enabled        = true
        process.conda        = '/home/mahasiswa/miniconda3/envs/ngs_platform'
        process.beforeScript = 'export PATH=/home/mahasiswa/miniconda3/envs/ngs_platform/bin:$PATH'
    }
}

// Konfigurasi laporan eksekusi
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
